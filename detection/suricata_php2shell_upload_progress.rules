# PHP2Shell (CVE-2026-109618 / CVE-2026-109619) — network-layer detection
#
# Pre-exploitation + receipt signals, Suricata HTTP rules.
# Lineage: the trigger rule mirrors the public detection guides
# (78ResearchLab/PHP2Shell-Full-Chain-Exploit, Huntress, watchTowr); the
# receipt-fetch rule covers the file-oracle shape the lab POCs use
# (verify_109619_rce.py GET /p, verify_rce_gadget.py writes rce-proof.txt).
#
# The PHP_SESSION_UPLOAD_PROGRESS field name is reserved for PHP's upload
# progress tracking and is rarely sent by legitimate applications, so a
# multipart POST carrying it is a high-confidence malicious indicator.

# --- 1. trigger: multipart POST declaring upload progress ------------------
alert http any any -> any any ( msg:"PHP2Shell session.upload_progress trigger (CVE-2026-109618/109619)"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; reference:cve,2026-109618; reference:cve,2026-109619; reference:url,www.php.net/archive/2026.php; classtype:web-application-attack; metadata:created_at 2026_10_21, updated_at 2026_10_22; sid:210961801; rev:1; )

# --- 2. receipt: proof-file fetch in the webroot ----------------------------
# The file-oracle exploits write command output into the served webroot
# (id>/var/www/html/p, /pwn.txt) and retrieve it with a short GET. Match the
# known artifact names with a short URI.
alert http any any -> any any ( msg:"PHP2Shell webroot proof-file receipt (post-exploitation)"; flow:established,to_server; http.method; content:"GET"; http.uri; pcre:"/^\/(p|pwn\.txt|rce\-proof\.txt|oob\.txt)(\?|$)/i"; reference:cve,2026-109618; reference:cve,2026-109619; classtype:web-application-activity; metadata:created_at 2026_10_22, updated_at 2026_10_22; sid:210961802; rev:1; )

# --- 3a. Wiz Variant 1: legacy 1005-part chain ------------------------------
# 1,001 x p0000 + null-byte PHPSESSID + 12 MB `big` field. Seen failing at
# post_max_size, but the shape is the kit's fingerprint.
alert http any any -> any any ( msg:"PHP2Shell legacy 1005-part chain (null-byte PHPSESSID + big field)"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; http.request_body; pcre:"/name=\"PHPSESSID\"\r\n\r\n\x00/"; http.request_body; content:"name=\"big\""; reference:cve,2026-109618; reference:cve,2026-109619; classtype:web-application-attack; metadata:created_at 2026_10_27, updated_at 2026_10_27; sid:210961804; rev:1; )

# --- 3b. Wiz Variant 2 / 9bie A1: chunked OOM arming ------------------------
# Chunked multipart, null-byte session id, empty file controls and nested
# `files[...]` names. A1 is the END-cleanup memory-exhaustion stage.
alert http any any -> any any ( msg:"PHP2Shell A1 chunked OOM arming (null-byte PHPSESSID + empty file parts)"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHPSESSID"; fast_pattern; content:"filename="; content:"files["; pcre:"/name=\"PHPSESSID\"\r\n\r\n\x00/"; reference:cve,2026-109618; classtype:web-application-attack; metadata:created_at 2026_10_27, updated_at 2026_10_28; sid:210961805; rev:2; )

# --- 3c. B1 leak follow-up: aNNNN[k] array names -----------------------------
# The reuse/leak consumer after A1. Weak on its own; the flowbit and the
# A1 correlation are what make it high-confidence.
alert http any any -> any any ( msg:"PHP2Shell B1 leak follow-up (aNNNN[k] array reclaim)"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; http.request_body; pcre:"/name=\"a\d{4}\[\d+\]\"/"; reference:cve,2026-109619; classtype:web-application-attack; metadata:created_at 2026_10_27, updated_at 2026_10_27; sid:210961806; rev:1; )

# --- 3d. LFI receipt: session-file inclusion --------------------------------
# The branded session-poisoning tools include /tmp/sess_<id> through an app
# LFI (lfi_sink.php?f=/tmp/sess_...). A bare path in the URI is high-signal.
alert http any any -> any any ( msg:"PHP2Shell session-file LFI receipt (/tmp/sess_)"; flow:established,to_server; http.uri.raw; content:"/tmp/sessions/sess_"; nocase; reference:cve,2026-109619; classtype:web-application-attack; metadata:created_at 2026_10_27, updated_at 2026_10_27; sid:210961807; rev:2; )

# --- 3e. Session poisoning with inline PHP ----------------------------------
# PHP code placed in the upload-progress field (the fake PHP2Shell tools).
alert http any any -> any any ( msg:"PHP2Shell-branded session poisoning (<?php in upload-progress field)"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; http.request_body; content:"<?php"; reference:cve,2026-109619; classtype:web-application-attack; metadata:created_at 2026_10_27, updated_at 2026_10_27; sid:210961808; rev:1; )

# --- 3f. Content-Type separator bypass --------------------------------------
# PHP accepts "multipart/form-data, boundary=X" (comma, not semicolon).
# Rules anchored on "; boundary=" miss it; this catches the bypass shape.
alert http any any -> any any ( msg:"PHP2Shell multipart Content-Type comma-separator bypass"; flow:established,to_server; http.method; content:"POST"; http.content_type; pcre:"/multipart\/form-data\s*,/i"; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; reference:cve,2026-109618; classtype:web-application-attack; metadata:created_at 2026_10_27, updated_at 2026_10_27; sid:210961809; rev:1; )

# --- 3g. Worker-occupation burst --------------------------------------------
# Many multi-MB declared bodies from one source with no progress field (the
# stalls used to pin workers). Threshold, not a single-packet rule.
alert http any any -> any any ( msg:"PHP2Shell worker-occupation burst (large declared bodies)"; flow:established,to_server; http.method; content:"POST"; http.header; pcre:"/Content-Length:\s*[0-9]{7,}/i"; threshold:type both, track by_src, count 40, seconds 60; reference:cve,2026-109618; classtype:web-application-activity; metadata:created_at 2026_10_27, updated_at 2026_10_27; sid:210961810; rev:1; )

# --- 3. timing-oracle fingerprint (blind variant) ---------------------------
# The blind oracle triggers upload progress and stalls uploads to read timing
# differences; observable as repeated large multipart POSTs with the progress
# field and very low inter-request gaps. Threshold rule — tune window/count
# to the deployment.
alert http any any -> any any ( msg:"PHP2Shell repeated upload-progress POSTs (possible timing oracle)"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; classtype:web-application-attack; threshold:type both, track by_src, count 10, seconds 60; metadata:created_at 2026_10_22, updated_at 2026_10_22; sid:210961803; rev:1; )
